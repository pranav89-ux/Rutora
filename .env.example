# Backend public or self-hosted-compatible service endpoints
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
ROUTING_URL=https://router.project-osrm.org

# Frontend XYZ map tile templates (keep provider attribution in the UI)
VITE_STREET_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_SATELLITE_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_SATELLITE_ATTRIBUTION='&copy; <a href="https://goto.arcgisonline.com/maps/World_Imagery">Esri World Imagery</a>, Vantor, Earthstar Geographics, and the GIS User Community'
API_PORT=8000
# Set HOST=0.0.0.0 on a public host such as Render.
HOST=127.0.0.1
# Set this to the deployed API origin when building the frontend; leave blank for local Vite proxy use.
VITE_API_URL=
